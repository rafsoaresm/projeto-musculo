# Optional LOCAL mount path to simulate a sub-path, e.g. /treinador. Empty = root.
# Do not set it on Webflow: its builder injects basePath and assetPrefix itself.
BASE_URL=
ASSETS_PREFIX=
# Authentication: generate independent secrets per deployed environment.
# For local development run npm run auth:setup:local (creates ignored files).
AUTH_SECRET=
# Exact origin, no trailing slash or mount path. HTTPS in Webflow.
AUTH_ORIGIN=
# SQLite is provided by the native Webflow Cloud DB binding in wrangler.json.
# No database URL, token or Supabase account is needed.
# One-time activation of the first platform manager ("gestor da ferramenta").
# 32+ random characters, e.g. openssl rand -base64 48. Works only while there is
# no active manager; remove or rotate it afterwards. Never a NEXT_PUBLIC_ value.
PLATFORM_SETUP_TOKEN=
# "true" enables /demonstracao (fictional data, nothing saved). Leave empty in
# production unless you want that area public.
DEMO_MODE=
# Recovery of a forgotten password by e-mail (Amazon SES). All five must be set, or the recovery
# stays off. Put them in the Webflow dashboard (the secret one as a secret variable), never in the
# repository: docs/WEBFLOW-CLOUD.md has the step by step.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=
# "capture" keeps the text of e-mail in the LOCAL database for the browser tests. Only honoured on
# localhost or 127.0.0.1. Leave empty everywhere else.
EMAIL_TRANSPORT=
