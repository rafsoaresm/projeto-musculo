# Optional local mount path, e.g. /treinador. Empty = root.
# Webflow's builder injects its own basePath and assetPrefix at deployment.
BASE_URL=
ASSETS_PREFIX=
# Authentication: generate independent secrets per deployed environment.
# For local development run npm run auth:setup:local (creates ignored files).
AUTH_SECRET=
# Exact origin, no trailing slash or mount path. HTTPS in Webflow.
AUTH_ORIGIN=
# SQLite is provided by the native Webflow Cloud DB binding in wrangler.json.
# No database URL, token or Supabase account is needed.
